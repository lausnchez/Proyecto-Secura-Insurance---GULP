include ../../mixins/generales/_general-outline-button.pug 

.proximas-renovaciones__filter 
    .p-renovaciones__filter__filter
        +general-outline-button("Filtros","filter")(id = 'pr-filter-modal-button')
        .p-renovaciones__filter__filterContainer
    .p-renovaciones__filter__num-selector
        .p-renovaciones__filter__filter__dataContainer
            span.p-renovaciones__filter__num-selector__totalPolizas
