                span.p-renovaciones__filter__num-selector__totalFiltros__filtros 7 filtros aplicados
                button.p-renovaciones__filter__num-selector__totalFiltros__borrarFiltros Borrar filtros
        .p-renovaciones__filter__num-selector__selector 
            span Ordenar por: 
            select#p-renovaciones__filter__num-selector__selector-input