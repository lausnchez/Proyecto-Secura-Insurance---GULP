include ../generales/_general-update-button.pug
include ../generales/_general-outline-button.pug

mixin detalle-poliza-card-variant(id, cardTitle)
    div(id=`detalle-poliza-card-${id}`).detalle-poliza-card
        .detalle-poliza__header 
            h2= cardTitle 
        .detalle-poliza__contents
            block
        .detalle-poliza__contents__edit
            +general-update-button("Actualizar")(id=`detalle-poliza__variant-update-button-${id}` class="detalle-poliza__variant-update-button detalle-poliza__update-button")
            +general-outline-button("Guardar cambios")(id=`detalle-poliza__variant-save-button-${id}` class="detalle-poliza__variant-save-button detalle-poliza__save-button detalle-poliza__contents__edit--hidden")
            //- detalle-poliza__header-save-button--hidden