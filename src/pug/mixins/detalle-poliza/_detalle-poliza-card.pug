include ../generales/_general-update-button.pug
include ../generales/_general-outline-button.pug

mixin detalle-poliza-card(id, cardTitle)
    div(id=`detalle-poliza-card-${id}`).detalle-poliza-card
        .detalle-poliza__header 
            h2= cardTitle 
            +general-update-button("Actualizar")(id=`detalle-poliza__header-update-${id}`)
        .detalle-poliza__contents
            block
            +general-outline-button("Guardar cambios")(id=`detalle-poliza__header-save-${id}` class="detalle-poliza__header-save-button detalle-poliza__header-save-button--hidden")
            

        