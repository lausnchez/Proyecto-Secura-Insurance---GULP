doctype
html(lang="es")
	head
		meta(charset="utf-8")
		meta(name="viewport" content="width=device-width, initial-scale=1.0")
		link(href="css/main.min.css" rel="stylesheet" media="all")
		block head

	block vars
		- var pageID = typeof pageID !== 'undefined' ? pageID : ''
		- var pageClass = typeof pageClass !== 'undefined' ? pageClass : ''

	body.default-font(data-page=pageID)

		- var mainClass = "main-content";

		if (pageClass)
			- var mainClass = mainClass + ' ' + pageClass;

		header(id="header", class="header")
			include header.pug

		main(id="main-content", class=mainClass)
			block content

		footer(id="footer" class="footer")
			include footer.pug

		script(src="js/main.js" type="module")
		block modal