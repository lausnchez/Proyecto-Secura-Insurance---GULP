include ../../mixins/proximas_renovaciones/_proximas-renovaciones-tag.pug

mixin p-renovaciones-row(content)
    // VALORES POR DEFECTO
    - var fecha_Hoy = new Date();
    //- - today.setFullYear(today.getFullYear() + 1);
    - var fecha_Vencimiento_Default = new Date(fecha_Hoy);
    - fecha_Vencimiento_Default.setFullYear(fecha_Hoy.getFullYear() + 1);

    // DATOS DE LA RENOVACIÓN
    - var no_poliza = content.no_poliza || '0';
    - var nombre_riesgo = content.nombre_riesgo || 'No definido';
    - var fecha_contrato = content.fecha_contrato ? new Date(content.fecha_contrato) : fechaHoy
    - var fecha_vencimiento = content.fecha_vencimiento ? new Date(content.fecha_vencimiento) : fecha_Vencimiento_Default;
    - var importe = content.importe || '0';
    - var estado = content.estado_poliza || 'Pendiente';

    .proximas-renovaciones-row 
        .proximas-renovaciones__contenedor
            span.proximas-renovaciones__contenedor-title.base_body No. de póliza
            span.proximas-renovaciones-row__numPoliza= no_poliza
        .proximas-renovaciones__contenedor
            span.proximas-renovaciones__contenedor-title.base_body Nombre del riesgo
            span.proximas-renovaciones-row__nombreRiesgo= nombre_riesgo
        .proximas-renovaciones__contenedor
            span.proximas-renovaciones__contenedor-title.base_body Fecha de contrato
            span.proximas-renovaciones-row__fechaContrato= fecha_contrato.toLocaleDateString('es-ES')
        .proximas-renovaciones__contenedor
            span.proximas-renovaciones__contenedor-title.base_body Fecha de vencimiento
            span.proximas-renovaciones-row__fechaVencimiento= fecha_vencimiento.toLocaleDateString('es-ES')
        .proximas-renovaciones__contenedor
            span.proximas-renovaciones__contenedor-title.base_body Importe
            span.proximas-renovaciones-row__importe.base_body_bold #{importe} €
        .proximas-renovaciones__contenedor
            span.proximas-renovaciones__contenedor-title.base_body Estado
            +proximas-renovaciones-tag(estado)