//- include ../fragments/_header-submenu-item.pug
include ../mixins/_header-submenu-item.pug
include ../mixins/_header-navbar-links.pug

//- logotipo, páginas de menu, desplegable de perfil, selector de idioma
header.header
    .header__contentPrincipal 
        nav.header__navBar 
            a(href="#")
                .header__logo-container
                    img(src="images/secura-insurance_logo.png", alt="Logotipo de Secura-Insurance")
            .header__navBarLinks
                +header-navbar-links("header__desktop-submenu-navbar")
        ul.header__submenus
            .header__desktop-submenu
                li
                    +header-submenu-item("Mi perfil", "user")
                    include ../fragments/_header-profile-dropdown.pug
                li
                    +header-submenu-item("Español", "globe")
                    include ../fragments/_header-language-dropdown.pug
            .header__mobile-submenu
                li.header__mobile-submenu-item
                    a(href="#")
                        span.icon-user
                li.header__mobile-submenu-item
                    a(href="#")
                        span.icon-burger_menu
    .mobile-dropdown-wrapper
        +header-navbar-links("header__mobile-submenu-navbar")