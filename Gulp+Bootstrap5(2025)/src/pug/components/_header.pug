include ../fragments/_header-submenu-item.pug

//- logotipo, páginas de menu, desplegable de perfil, selector de idioma
header.header
    nav.header__navBar 
        a(href="#")
            .header__logo-container
                img(src="images/secura-insurance_logo.png", alt="Logotipo de Secura-Insurance")
        .header__navBarLinks
            a.navbar-text(href="#") Inicio
            a.navbar-text(href="#") Próximas renovaciones
    ul.header__submenus
        li
            +header-submenu-item("Mi perfil", "user")
            include ../fragments/_header-profile-dropdown.pug
        li
            +header-submenu-item("Español", "globe")
            include ../fragments/_header-language-dropdown.pug